#!/bin/sh

DIR_RUN="/opt/vless-watchdog"
DIR_WORK="/var/run/vless-watchdog"
FILE_SOURCE="${DIR_WORK}/source.txt"
FILE_FAVORITES="${DIR_WORK}/favorites.txt"
FILE_LOCK="${DIR_WORK}/vless-watchdog.lock"
FILE_XRAY_CONF="${DIR_WORK}/xray-config.json"
PATH_XRAY_BIN="${DIR_RUN}/bin/xray_softfloat"
URL_SOURCE="https://raw.githack.com/igareck/vpn-configs-for-russia/main/BLACK_VLESS_RUS.txt"
URL_TEST="http://www.google.com"
BLACKLIST_WORD="Telegram|video?ed=1024"
COUNTRY_EXCLUDE="Russia|Belarus|Kazakhstan|Ukraine"

mkdir -p "$DIR_RUN" "$DIR_WORK"

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

regex_escape() {
    printf '%s' "$1" | sed 's/[.^$*+?()[\]{}\\]/\\&/g'
}

decode_param() {
    printf '%s' "$1" | sed \
        -e 's/+/ /g' \
        -e 's/%21/!/g' -e 's/%22/"/g' -e 's/%23/#/g' -e 's/%24/$/g' \
        -e 's/%25/%/g' -e 's/%26/\&/g' -e 's/%27/'\''/g' -e 's/%28/(/g' \
        -e 's/%29/)/g' -e 's/%2A/*/g' -e 's/%2B/+/g' -e 's/%2C/,/g' \
        -e 's/%2D/-/g' -e 's/%2E/./g' -e 's/%2F/\//g' \
        -e 's/%3A/:/g' -e 's/%3B/;/g' -e 's/%3C/</g' -e 's/%3D/=/g' \
        -e 's/%3E/>/g' -e 's/%3F/?/g' -e 's/%40/@/g' \
        -e 's/%5B/[/g' -e 's/%5C/\\/g' -e 's/%5D/]/g' -e 's/%5E/^/g' \
        -e 's/%5F/_/g' -e 's/%60/`/g' \
        -e 's/%7B/{/g' -e 's/%7C/|/g' -e 's/%7D/}/g' -e 's/%7E/~/g'
}

format_json() {
    printf '{"uid":"%s","address":"%s","port":%s' "$uid" "$address" "$port"
    [ -n "$fp" ] && printf ',"fp":"%s"' "$fp"
    [ -n "$security" ] && printf ',"security":"%s"' "$security"
    [ -n "$sni" ] && printf ',"sni":"%s"' "$sni"
    [ -n "$host" ] && printf ',"host":"%s"' "$host"
    [ -n "$path" ] && printf ',"path":"%s"' "$path"
    [ -n "$type" ] && printf ',"type":"%s"' "$type"
    [ -n "$flow" ] && printf ',"flow":"%s"' "$flow"
    [ -n "$pbk" ] && printf ',"pbk":"%s"' "$pbk"
    [ -n "$sid" ] && printf ',"sid":"%s"' "$sid"
    [ -n "$alpn" ] && printf ',"alpn":"%s"' "$alpn"
    [ -n "$extra" ] && printf ',"extra":%s' "$extra"
    [ -n "$headerType" ] && printf ',"headerType":"%s"' "$headerType"
    [ -n "$mode" ] && printf ',"mode":"%s"' "$mode"
    [ -n "$serviceName" ] && printf ',"serviceName":"%s"' "$serviceName"
    printf '}\n'
}

parse_vless() {
    local link="$1"
    local uid="" address="" port=""
    local fp="chrome" security="" sni=""
    local host="" path="" type="tcp"
    local flow="" pbk="" sid=""
    local alpn="" extra="" headerType="" mode="" serviceName=""

    case "$link" in "vless://"*) ;; *) return 1 ;; esac

    local raw_reference="${link%%\#*}"; raw_reference="${raw_reference#vless://}"
    local raw_fragment=$(printf '%s' "$link" | cut -d'#' -f2-)
    uid="${raw_reference%%@*}"
    local addrport="${raw_reference#*@}"; addrport="${addrport%%\?*}"; addrport="${addrport%%/*}"
    address="${addrport%%:*}"; port="${addrport#*:}"
    local raw_params="${raw_reference#*\?}"; [ "$raw_params" = "$raw_reference" ] && raw_params=""

    if [ -n "$raw_params" ]; then
        local OLD_IFS="$IFS"; IFS="&"
        for param in $raw_params; do
            local key="${param%%=*}"; local val="${param#*=}"
            case "$key" in
                fp) fp="$val" ;;
                security) security="$val" ;;
                sni) sni=$(json_escape "$(decode_param "$val")") ;;
                host) host=$(json_escape "$(decode_param "$val")") ;;
                path) path=$(json_escape "$(decode_param "$val")") ;;
                type) type="$val" ;;
                flow) flow="$val" ;;
                pbk) pbk=$(json_escape "$(decode_param "$val")") ;;
                sid) sid=$(json_escape "$(decode_param "$val")") ;;
                alpn) alpn=$(decode_param "$val") ;;
                extra) extra=$(decode_param "$val") ;;
                headerType) headerType="$val" ;;
                mode) mode="$val" ;;
                serviceName) serviceName=$(json_escape "$(decode_param "$val")") ;;
            esac
        done
        IFS="$OLD_IFS"
    fi

    [ -n "$uid" ] || return 1
    [ -n "$address" ] || return 1
    [ "$port" = "$addrport" ] && port="443"

    [ "$security" = "tls" ] && { [ -n "$sni" ] || return 1; }
    [ "$security" = "reality" ] && { [ -n "$pbk" ] && [ -n "$sid" ] || return 1; }

    [ "$security" != "tls" ] && [ "$security" != "reality" ] && security="none"
    [ "$security" = "none" ] && [ -z "$sni" ] && sni="$address"
    [ "$type" = "raw" ] && type="tcp"

    case " tcp ws grpc xhttp " in *" $type "*) ;; *) return 1 ;; esac

    COUNTRY=$(printf '%s' "$raw_fragment" | sed 's/%7C/|/g; s/%[0-9A-F][0-9A-F]//g; s/%20/ /g; s/%2C/,/g' | sed 's/|.*//; s/[^a-zA-Z, ]//g; s/^[ ]*//; s/[ ]*$//')
    [ -z "$COUNTRY" ] && COUNTRY="NotSpecified"

    JSON=$(format_json)
    return 0
}

generate_config() {
    local json_data="$1"
    local uid=$(echo "$json_data" | jsonfilter -e '@.uid')
    local address=$(echo "$json_data" | jsonfilter -e '@.address')
    local port=$(echo "$json_data" | jsonfilter -e '@.port')
    local fp=$(echo "$json_data" | jsonfilter -e '@.fp')
    local security=$(echo "$json_data" | jsonfilter -e '@.security')
    local sni=$(echo "$json_data" | jsonfilter -e '@.sni')
    local host=$(echo "$json_data" | jsonfilter -e '@.host')
    local path=$(echo "$json_data" | jsonfilter -e '@.path')
    local type=$(echo "$json_data" | jsonfilter -e '@.type')
    local flow=$(echo "$json_data" | jsonfilter -e '@.flow')
    local pbk=$(echo "$json_data" | jsonfilter -e '@.pbk')
    local sid=$(echo "$json_data" | jsonfilter -e '@.sid')
    local alpn=$(echo "$json_data" | jsonfilter -e '@.alpn')
    local extra=$(echo "$json_data" | jsonfilter -e '@.extra')
    local headerType=$(echo "$json_data" | jsonfilter -e '@.headerType')
    local mode=$(echo "$json_data" | jsonfilter -e '@.mode')
    local serviceName=$(echo "$json_data" | jsonfilter -e '@.serviceName')

    local users="\"id\": \"$uid\", \"encryption\": \"none\""
    [ -n "$flow" ] && [ "$type" = "tcp" ] && users="$users, \"flow\": \"$flow\""

    local encryption=""
    case "$security" in
        reality)
            encryption="\"realitySettings\": { \"fingerprint\": \"$fp\", \"serverName\": \"$sni\", \"publicKey\": \"$pbk\", \"shortId\": \"$sid\" }"
            ;;
        tls)
            encryption="\"tlsSettings\": { \"serverName\": \"$sni\", \"fingerprint\": \"$fp\""
            if [ -n "$alpn" ]; then
                case ",$alpn," in
                    *,h2,*|*,h3,*|*,http/1.1,*)
                        format_alpn=$(printf '%s' "$alpn" | sed 's/[^,]\+/"&"/g; s/^/[/;s/$/]/')
                        encryption="${encryption}, \"alpn\": $format_alpn"
                        ;;
                esac
            fi
            encryption="${encryption} }"
            ;;
    esac

    local transport=""
    case "$type" in
        ws)
            transport="\"wsSettings\": { \"path\": \"${path:-/}\", \"headers\": { \"Host\": \"${host:-$sni}\" } }"
            ;;
        grpc)
            transport="\"grpcSettings\": { \"serviceName\": \"${serviceName:-grpc}\""
            [ -n "$host" ] && transport="${transport}, \"authority\": \"$host\""
            [ "$mode" = "gun" ] && transport="${transport}, \"multiMode\": true"
            transport="${transport} }"
            ;;
        xhttp)
            transport="\"xhttpSettings\": { \"path\": \"${path:-/}\""
            [ -n "$host" ] && transport="${transport}, \"host\": \"$host\""
            [ -n "$mode" ] && transport="${transport}, \"mode\": \"$mode\""
            [ -n "$extra" ] && transport="${transport}, \"extra\": $extra"
            transport="${transport} }"
            ;;
        *)
            transport="\"tcpSettings\": { \"header\": { \"type\": \"${headerType:-none}\" } }"
            ;;
    esac

    local streamSettings="\"network\": \"$type\", \"security\": \"$security\", \"sockopt\": { \"mark\": 255 }"
    [ -n "$encryption" ] && streamSettings="${streamSettings}, $encryption"
    [ -n "$transport" ] && streamSettings="${streamSettings}, $transport"

    cat << JSON
{
    "log": {
        "loglevel": "none"
    },
    "inbounds": [
        {
            "listen": "127.0.0.1",
            "port": 8010,
            "protocol": "http",
            "settings": {
                "udp": false
            }
        },
        {
            "listen": "0.0.0.0",
            "port": 54321,
            "protocol": "dokodemo-door",
            "settings": {
                "network": "tcp,udp",
                "followRedirect": true
            },
            "streamSettings": {
                "sockopt": {
                    "tproxy": "tproxy"
                }
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "vless",
            "settings": {
                "vnext": [
                    {
                        "address": "$address",
                        "port": $port,
                        "users": [
                            {
                                $users
                            }
                        ]
                    }
                ]
            },
            "streamSettings": {
                $streamSettings
            }
        }
    ]
}
JSON
}

update_source() {
    echo "Info: Trying to download source file..."
    if curl -ksSL --connect-timeout 7 -m 9 "$URL_SOURCE" > "$FILE_SOURCE"; then
        echo "Info: Source file updated, contains $(grep -c "^vless://" "$FILE_SOURCE" 2>/dev/null || echo "0") lines."
        return 0
    else
        echo "Error: Failed to download source file!"
        return 1
    fi
}

start_xray() {
    killall xray_softfloat 2>/dev/null
    generate_config "$JSON" > "$1"
    for i in 1 2 3 4 5 6 7; do
        netstat -an 2>/dev/null | grep -qE ":(8010|54321).*LISTEN" || break
        sleep 1
    done
    $PATH_XRAY_BIN run -c "$1" >/dev/null 2>&1 &
    for i in 1 2 3 4 5; do
        netstat -an 2>/dev/null | grep -qE "127.0.0.1:8010.*LISTEN" && return 0
        sleep 1
    done
    return 1
}

check_connection() {
    local start_check=$(cat /proc/uptime | awk '{print $1}')
    curl -x http://127.0.0.1:8010 -s --connect-timeout 1 -m 3 "$URL_TEST" -o /dev/null -w "%{http_code}" 2>/dev/null | grep -qE "20[04]|30[12]"
    local result=$?
    local end_check=$(cat /proc/uptime | awk '{print $1}')
    TIMING_CHECK=$(awk "BEGIN {printf \"%.3f\", $end_check - $start_check}")
    [ $result -eq 0 ] && [ "${TIMING_CHECK%.*}" -lt 3 ]
}

build_favorites() {
    if [ -f "$FILE_LOCK" ] || [ ! -s "$FILE_SOURCE" ]; then
        [ -f "$FILE_LOCK" ] && echo "Warning: Another instance is running (lock file exists)."
        [ -f "$FILE_LOCK" ] || echo "Warning: Source file not found. Use 'vless-watchdog update'."
        exit 1
    fi

    trap 'rm -f "$FILE_LOCK"' EXIT INT TERM
    touch "$FILE_LOCK"

    local tmp_favorites="${DIR_WORK}/favorites.tmp"
    > "$tmp_favorites"
    > "$FILE_FAVORITES"

    local count=0 active=0
    local total=$(grep -c "^vless://" "$FILE_SOURCE" 2>/dev/null || echo "0")
    local start_build=$(date +%s)

    while IFS= read -r line || [ -n "$line" ]; do
        [ -z "$line" ] && continue
        parse_vless "$line" || continue
        [ -z "$JSON" ] && continue
        [ -n "$BLACKLIST_WORD" ] && echo "$line" | grep -qiE "$(regex_escape "$BLACKLIST_WORD")" && continue
        [ -n "$COUNTRY_EXCLUDE" ] && echo "$COUNTRY" | grep -qiE "$COUNTRY_EXCLUDE" && continue

        count=$((count + 1))
        echo -ne "\r Processing: [$count/$total] ⏳"

        if start_xray "${FILE_XRAY_CONF%.json}.tmp.json"; then
            if check_connection; then
                echo "${TIMING_CHECK}|${JSON}|${COUNTRY}" >> "$tmp_favorites"
                active=$((active + 1))
            fi
        fi
    done < "$FILE_SOURCE"

    local end_build=$(date +%s)
    echo -e "\r Processing: [$count/$total] ✅"
    killall xray_softfloat 2>/dev/null

    if [ -s "$tmp_favorites" ]; then
        sort -t'|' -k1 -n "$tmp_favorites" | awk -F'|' '
        {
            match($2, /"address":"[^"]*"/); split(substr($2, RSTART, RLENGTH), a, "\""); addr = a[4]
            match($2, /"uid":"[^"]*"/); split(substr($2, RSTART, RLENGTH), u, "\""); uid = u[4]
            if (addr && uid && !seen_a[addr]++ && !seen_u[uid]++) {
                print $2 "|" $3
            }
        }' | head -15 > "$FILE_FAVORITES"
    fi

    echo "=====FAVORITES====="

    if [ -s "$FILE_FAVORITES" ]; then
        local time address port security type
        while IFS='|' read -r JSON COUNTRY; do
            time=$(grep -F "|${JSON}|" "$tmp_favorites" | cut -d'|' -f1 | head -1)
            address=$(echo "$JSON" | jsonfilter -e '@.address')
            port=$(echo "$JSON" | jsonfilter -e '@.port')
            security=$(echo "$JSON" | jsonfilter -e '@.security')
            type=$(echo "$JSON" | jsonfilter -e '@.type')
            printf " %-7s | %-15s | %-25.25s | %-35.35s\n" "${time}s" "[$security/$type]" "$COUNTRY" "$address:$port"
        done < "$FILE_FAVORITES"
        echo "==================="
        echo " Actives: $active | Time: $((end_build - start_build))s"
    else
        echo "Error: No active servers found!"
    fi

    rm -f "${FILE_XRAY_CONF%.json}.tmp.json" "$FILE_LOCK"
}

switch_next() {
    if [ -f "$FILE_LOCK" ] || [ ! -s "$FILE_FAVORITES" ]; then
        [ -f "$FILE_LOCK" ] && echo "Warning: Another instance is running (lock file exists)."
        [ -f "$FILE_LOCK" ] || echo "Warning: Favorites file not found. Use 'vless-watchdog build'."
        exit 1
    fi

    trap 'rm -f "$FILE_LOCK"' EXIT INT TERM
    touch "$FILE_LOCK"

    local current_address=$(jsonfilter -e '@.outbounds[0].settings.vnext[0].address' < "$FILE_XRAY_CONF")
    local first="" found=0 next=""

    while IFS='|' read -r JSON COUNTRY || [ -n "$JSON" ]; do
        [ -z "$JSON" ] && continue
        [ -z "$first" ] && first="$JSON"
        local address=$(echo "$JSON" | jsonfilter -e '@.address')
        if [ "$found" -eq 1 ] && [ "$address" != "$current_address" ]; then
            next="$JSON"
            break
        fi
        [ "$address" = "$current_address" ] && found=1
    done < "$FILE_FAVORITES"

    [ -z "$next" ] && next="$first"
    JSON="$next"

    if start_xray "$FILE_XRAY_CONF"; then
        if check_connection; then
            echo "Info: Switched to next server: $(echo "$next" | jsonfilter -e '@.address'):$(echo "$next" | jsonfilter -e '@.port')"
            rm -f "$FILE_LOCK"
            exit 0
        fi
    fi

    echo "Warning: This server is unavailable, please switch to another one."
    rm -f "$FILE_LOCK"
    exit 1
}

main() {
    if [ -f "$FILE_LOCK" ]; then
        echo "Warning: Another instance is running (lock file exists)."
        exit 1
    fi

    if [ -f "$FILE_XRAY_CONF" ] && check_connection; then
        echo "Info: The connection works!"
        exit 0
    fi

    trap 'rm -f "$FILE_LOCK"' EXIT INT TERM
    touch "$FILE_LOCK"

    local address="" port="" found=0

    if [ -s "$FILE_FAVORITES" ]; then
        while IFS='|' read -r JSON COUNTRY || [ -n "$JSON" ]; do
            [ -z "$JSON" ] && continue
            if start_xray "$FILE_XRAY_CONF" && check_connection; then
                address=$(echo "$JSON" | jsonfilter -e '@.address')
                port=$(echo "$JSON" | jsonfilter -e '@.port')
                found=1
                break
            fi
        done < "$FILE_FAVORITES"
    fi

    if [ "$found" -eq 1 ]; then
        echo "Info: Connection established, current server $address:$port."
        rm -f "$FILE_LOCK"
        exit 0
    fi

    rm -f "$FILE_LOCK"

    echo "Warning: No available servers found, trying to rebuild the favorites list..."
    build_favorites

    if [ ! -s "$FILE_FAVORITES" ]; then
        echo "Error: No active servers found in source file. Use 'vless-watchdog update'."
        exit 1
    else
        echo "Info: Favorites list rebuilt successfully. Use 'vless-watchdog main'."
        exit 0
    fi
}

case "$1" in
    update) update_source ;;
    build) build_favorites ;;
    next) switch_next ;;
    main) main ;;
    *) echo "Usage: $0 {update|build|next|main}"; exit 1 ;;
esac
